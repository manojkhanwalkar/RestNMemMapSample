<?xml version="1.0" encoding="UTF-8"?>
<!-- Bootstrap logging before Dropwizard configures its own. Without this file logback defaults to
     DEBUG, and Spring then logs every environment variable (including FACADE_HMAC_KEY_C1). -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
